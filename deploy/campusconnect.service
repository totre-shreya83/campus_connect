[Unit]
Description=CampusConnect Gunicorn Service
After=network.target mysql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/campusconnect
Environment="PATH=/var/www/campusconnect/venv/bin"
EnvironmentFile=/var/www/campusconnect/.env
ExecStart=/var/www/campusconnect/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/var/www/campusconnect/campusconnect.sock \
    --access-logfile /var/www/campusconnect/logs/access.log \
    --error-logfile /var/www/campusconnect/logs/error.log \
    run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
