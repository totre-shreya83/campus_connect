FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=generate-a-long-random-value-do-not-reuse-dev-key

DATABASE_URL=mysql+pymysql://campusconnect_app:strong-db-password@localhost:3306/campusconnect

# AWS credentials are intentionally blank.
# On EC2, boto3 uses the attached IAM role automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=campusconnect-prod-yourname

BACKUP_PREFIX=backups/db/
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
